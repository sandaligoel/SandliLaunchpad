AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=you
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-search-key-here
AZURE_SEARCH_INDEX_NAME=agentic-launchpad

PDF_PATH=./data/spec.json
LOG_LEVEL=INFO

# Localhost persistence — Azure Blob (same data across restarts / machines)
DATA_STORAGE_BACKEND=blob
AZURE_STORAGE_ACCOUNT_NAME=affineblog
AZURE_STORAGE_CONTAINER_NAME=agentic-launchpad
# Quote the full string (semicolons break bash if you source this file):
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=affineblog;AccountKey=...;EndpointSuffix=core.windows.net"
# VITE_* vars belong in agentforge-ui/.env.local only — not here.

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:8000,http://127.0.0.1:8001,http://127.0.0.1:8002,http://127.0.0.1:8003
