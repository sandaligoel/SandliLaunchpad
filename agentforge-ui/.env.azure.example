# Connect AgentForge UI to AFFINE API running in Azure (Container App / App Service).
# Copy to .env.local and set your real HTTPS URL (no trailing slash).

# --- Option A: Local dev UI → Azure API (recommended; avoids CORS) ---
# Vite proxies /health and /api/sessions to this host:
AFFINE_API_TARGET=https://YOUR-API-HOST.azurecontainerapps.io
VITE_AFFINE_API_BASE=

# --- Option B: Browser calls Azure directly (needs CORS on API) ---
# AFFINE_API_TARGET=http://127.0.0.1:8003
# VITE_AFFINE_API_BASE=https://YOUR-API-HOST.azurecontainerapps.io

VITE_MOCK_API_TARGET=http://127.0.0.1:3001
