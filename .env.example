# Application
APP_NAME=agent-knowledge-retrieval
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-search-key
AZURE_SEARCH_INDEX_NAME=ai-architecture-knowledge
AZURE_SEARCH_CREATE_INDEX_ON_STARTUP=true
AZURE_SEARCH_SEMANTIC_CONFIG_NAME=architecture-semantic

# Ingestion pipeline
MAX_CHUNK_CHARS=6000
CHUNK_OVERLAP_CHARS=400
EXTRACTION_MAX_RETRIES=3
EXTRACTION_TEMPERATURE=0.1
EMBEDDING_BATCH_SIZE=16
PDF_PARSE_PAGE_BATCH_SIZE=50

# Search defaults
DEFAULT_SEARCH_TOP_K=10
HYBRID_VECTOR_WEIGHT=0.6

# Solution catalog PDF (solution_agents.pdf)
DEFAULT_SOLUTION_AGENTS_PDF=data/documents/solution_agents.pdf
SOLUTION_CATALOG_AUTO_DETECT=true
