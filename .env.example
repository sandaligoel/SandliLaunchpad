# Azure OpenAI (chat + embeddings)
GPT4_LLM_MODEL_DEPLOYMENT_NAME=
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
EMBEDDING_MODEL_DEPLOYMENT_NAME=

# Azure AI Search
AZURE_SEARCH_SERVICE_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=dupont_email_demo

# Eryl vector routing metadata (required — static reference, not live query)
# Set ONE of:
ERYL_VECTOR_DATA=
ERYL_VECTOR_DATA_PATH=examples/vector_metadata.txt

# Optional graph retrieval module (only if using graph/hybrid selector)
ERYL_LOCAL_CONTEXT_MODULE=

# Set DRY_RUN=true to exercise orchestration without live external calls
DRY_RUN=false
